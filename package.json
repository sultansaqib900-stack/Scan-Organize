{
  "name": "scan-and-organize",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/build-privacy.mjs && node scripts/next.mjs build && node scripts/build-offline.mjs",
    "preview": "serve out --listen tcp://0.0.0.0:3000 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "amazon:sync": "npm run android:sync",
    "amazon:open": "cap open android",
    "amazon:check": "node scripts/check-amazon.mjs",
    "test:fire": "playwright test --project=fire-hd-8 --project=fire-hd-10",
    "amazon:release": "node scripts/check-publisher.mjs && npm run amazon:sync",
    "amazon:submission-check": "node scripts/check-submission.mjs",
    "amazon:apk-check": "node scripts/check-apk.mjs",
    "amazon:assets": "node scripts/build-submission-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "jspdf": "4.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.6",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
